<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Mai Trung Duc</Authors>
    <Copyright>Copyright (c) Mai Trung Duc</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/maitrungduc1410/loader-kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/maitrungduc1410/loader-kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>loader;loading;indicator;spinner;animation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
